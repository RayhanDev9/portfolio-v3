{
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:css": "tailwindcss -i ./src/input.css -o ./css/output.css --watch",
    "build:css": "tailwindcss -i ./src/input.css -o ./css/output.css --minify",
    "build:html": "node scripts/build-html.js",
    "build": "tailwindcss -i ./src/input.css -o ./css/output.css --minify && node scripts/build-html.js && vite build",
    "preview": "vite preview",
    "convert:avif": "node scripts/convert-to-avif.js",
    "convert:avif:clean": "node scripts/convert-to-avif.js --delete-source"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.3.1",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "sharp": "^0.35.5",
    "vite": "^8.3.3",
    "vite-plugin-html-inject": "^1.1.2"
  }
}
